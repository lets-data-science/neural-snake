p_net_over_head_weight: PARAMETER target='net.over_head.weight'
p_net_over_head_bias: PARAMETER target='net.over_head.bias'
b_cls_ids: BUFFER target='cls_ids' persistent=True
b_act_ids: BUFFER target='act_ids' persistent=True
b_net_over_shift: BUFFER target='net.over_shift' persistent=True
b_net_ate_shift: BUFFER target='net.ate_shift' persistent=True
grid: USER_INPUT
action: USER_INPUT

# outputs
argmax: USER_OUTPUT
softmax: USER_OUTPUT
sigmoid_1: USER_OUTPUT
sigmoid_2: USER_OUTPUT
