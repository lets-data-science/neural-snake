# inputs
p_net_stem_weight: PARAMETER target='net.stem.weight'
p_net_stem_bias: PARAMETER target='net.stem.bias'
p_net_convs_0_weight: PARAMETER target='net.convs.0.weight'
p_net_convs_0_bias: PARAMETER target='net.convs.0.bias'
