p_net_convs_2_weight: PARAMETER target='net.convs.2.weight'
p_net_convs_2_bias: PARAMETER target='net.convs.2.bias'
p_net_convs_3_weight: PARAMETER target='net.convs.3.weight'
p_net_convs_3_bias: PARAMETER target='net.convs.3.bias'
p_net_convs_4_weight: PARAMETER target='net.convs.4.weight'
p_net_convs_4_bias: PARAMETER target='net.convs.4.bias'
p_net_convs_5_weight: PARAMETER target='net.convs.5.weight'
p_net_convs_5_bias: PARAMETER target='net.convs.5.bias'
p_net_convs_6_weight: PARAMETER target='net.convs.6.weight'
p_net_convs_6_bias: PARAMETER target='net.convs.6.bias'
p_net_g1_weight: PARAMETER target='net.g1.weight'
p_net_g1_bias: PARAMETER target='net.g1.bias'
p_net_g2_weight: PARAMETER target='net.g2.weight'
p_net_g2_bias: PARAMETER target='net.g2.bias'
p_net_ate_mlp_0_weight: PARAMETER target='net.ate_mlp.0.weight'
p_net_ate_mlp_0_bias: PARAMETER target='net.ate_mlp.0.bias'
p_net_ate_mlp_2_weight: PARAMETER target='net.ate_mlp.2.weight'
p_net_ate_mlp_2_bias: PARAMETER target='net.ate_mlp.2.bias'
p_net_inj_weight: PARAMETER target='net.inj.weight'
p_net_inj_bias: PARAMETER target='net.inj.bias'
p_net_cls_head_weight: PARAMETER target='net.cls_head.weight'
p_net_cls_head_bias: PARAMETER target='net.cls_head.bias'
p_net_food_head_weight: PARAMETER target='net.food_head.weight'
